rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function isAdmin(){return request.auth != null && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';}
  match /public/{allPaths=**}{
   allow get: if true;
   allow list: if isAdmin();
   allow create, update: if isAdmin() && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
   allow delete: if isAdmin();
  }
  match /{allPaths=**}{allow read, write: if false;}
 }
}
