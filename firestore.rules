rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin(){return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';}
  match /admins/{uid}{allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false;}
  match /books/{bookId}{allow read: if isAdmin() || resource.data.published == true; allow write: if isAdmin();}
  match /testimonials/{testimonialId}{allow read: if isAdmin() || resource.data.published == true; allow write: if isAdmin();}
  match /content/{documentId}{allow read: if isAdmin() || resource.data.published == true; allow write: if isAdmin();}
  match /{document=**}{allow read, write: if false;}
 }
}
